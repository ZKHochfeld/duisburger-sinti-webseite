---
layout: base.njk
titel: Start
---
{% from "karte.njk" import anzeigen %}
<section class="hero">
  <h1>Duisburger Sinti</h1>
  <p>{{ site.beschreibung }}</p>
</section>

<section>
  <h2>Medien-Übersicht</h2>
  <div class="medienraster">
    <a class="medienkachel" href="/presse/" style="--bild: url('{{ collections.presse[0].data.titelbild or '/assets/img/uploads/logo/logo.jpg' }}')">
      <div class="medienkachel__inhalt">
        <span class="medienkachel__zahl">{{ collections.presse.length }}</span>
        <span class="medienkachel__label">Presse &amp; Dokumente</span>
      </div>
    </a>
    <a class="medienkachel" href="/veranstaltungen/" style="--bild: url('{{ collections.veranstaltungen[0].data.titelbild or '/assets/img/uploads/logo/logo.jpg' }}')">
      <div class="medienkachel__inhalt">
        <span class="medienkachel__zahl">{{ collections.veranstaltungen.length }}</span>
        <span class="medienkachel__label">Veranstaltungen</span>
      </div>
    </a>
  </div>
</section>

<section>
  <h2>Aktuelles</h2>
  <p class="hinweis-text">Ein kleiner Einblick – das vollständige Archiv findest du unter <a href="/presse/">Presse &amp; Dokumente</a> und <a href="/veranstaltungen/">Veranstaltungen</a>.</p>
  <div class="kartenraster">
    {% for eintrag in collections.neueste %}
    {% if loop.index <= 12 %}
    {{ anzeigen(eintrag) }}
    {% endif %}
    {% endfor %}
  </div>
</section>
