---
layout: base.njk
titel: Foto-Galerien
permalink: /galerien/
eleventyExcludeFromCollections: true
---
<h1>Foto-Galerien</h1>

<div class="kartenraster">
  {% for eintrag in collections.galerien %}
  {% set bild = eintrag.data.titelbild or eintrag.data.fotos[0] or '/assets/img/uploads/logo/logo.jpg' %}
  <a class="karte" href="{{ eintrag.url }}">
    <img src="{{ bild }}" alt="" loading="lazy">
    <div class="karte__inhalt">
      <span class="abzeichen">Galerie</span>
      <h3>{{ eintrag.data.title }}</h3>
      <p class="karte__meta">{{ eintrag.data.date | datum }}</p>
    </div>
  </a>
  {% endfor %}
</div>
