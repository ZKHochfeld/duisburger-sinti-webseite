<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ titel or title }}{% if titel or title %} · {% endif %}{{ site.titel }}</title>
  <meta name="description" content="{{ beschreibung or site.beschreibung }}">
  <link rel="stylesheet" href="/assets/css/fonts.css">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
</head>
<body>
  <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
  <header class="site-header">
    <div class="wrap site-header__inner">
      <a class="site-header__logo" href="/">
        <img src="/assets/img/uploads/logo/logo.jpg" alt="" width="44" height="44">
        {{ site.titel }}
      </a>
      <nav class="site-nav" aria-label="Hauptnavigation">
        <button class="site-nav__toggle" aria-expanded="false" aria-controls="site-nav-list">Menü</button>
        <ul id="site-nav-list" class="site-nav__list">
          {% for item in site.nav %}
          <li><a href="{{ item.pfad }}" {% if page.url == item.pfad %}aria-current="page"{% endif %}>{{ item.titel }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <main id="inhalt" class="wrap">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>&copy; {{ jahr }} {{ site.titel }} · <a href="mailto:{{ site.kontaktEmail }}">{{ site.kontaktEmail }}</a></p>
      <p><a href="/impressum/">Impressum</a> · <a href="/datenschutz/">Datenschutz</a></p>
    </div>
  </footer>
  <button type="button" class="nach-oben" aria-label="Nach oben">↑</button>
  <script src="/assets/js/nav.js" defer></script>
  <script src="/assets/js/lightbox.js" defer></script>
  <script src="/assets/js/nach-oben.js" defer></script>
  <script src="/assets/js/video-facade.js" defer></script>
</body>
</html>
